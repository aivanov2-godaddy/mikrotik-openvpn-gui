# Router-local immutable release updater for MikroTik OpenVPN GUI.
#
# This is deliberately a static, reviewable RouterOS script.  It does NOT
# download or execute RouterOS code from GitHub.  It only downloads a JSON
# release manifest, validates one exact public ARM64 image tag, and stages it
# only to the pre-existing isolated canary. Production is changed only by the
# separate evidence-gated local promotion controller.
#
# Before importing: replace every CHANGE-ME value, create the scheduler below,
# and test it manually with a known-good release.  Do not place router secrets,
# certificates, domains, or IP addresses in a public repository.

:local manifestUrl "https://github.com/aivanov2-godaddy/mikrotik-openvpn-gui/releases/download/routeros-stable/routeros-release.json"
:local imagePrefix "ghcr.io/aivanov2-godaddy/mikrotik-openvpn-gui:sha-"
:local canaryContainer "vpn-dashboard-canary"
:local productionContainer "vpn-dashboard-production"
# Readiness may use HTTPS, or a literal RFC1918 IPv4 address on the router's
# private container network. The release manifest itself always remains HTTPS
# with certificate validation; local HTTP must never point to a public host.
:local canaryReadyUrl "http://192.168.250.2:8080/readyz"
:local stateFile "disk1/vpn-dashboard/routeros-update-state.txt"
:local pendingFile "disk1/vpn-dashboard/routeros-update-pending.txt"
:local historyFile "disk1/vpn-dashboard/routeros-update-history.log"
# Allow up to three minutes for router-layer download, extraction, and app boot.
# A 23 MB ARM64 layer took about 80 seconds to download on the target router.
:local pollAttempts 18
:local pollDelay 10s
# Stage only after a sampled canary readiness window. Production promotion is
# handled by the evidence-gated local controller, never by this scheduler.
# Thirty one-minute intervals provide at least 30 minutes of repeated probes.
:local canaryValidationInterval 1m
:local canaryValidationSamples 30
:local dryRun false
:local failureRetryLimit 3
:local failureFile ($stateFile . ".failed")
# Optional local maintenance window. Hours are RouterOS local time, start
# inclusive and end exclusive. A window that crosses midnight is supported.
:local maintenanceWindowEnabled false
:local maintenanceStartHour 2
:local maintenanceEndHour 5

# Tiny file helpers. The local state files contain only public image tags,
# commit IDs, counters, and timestamps. They are never copied to GitHub.
:local writeState do={
    :local fileName $1
    :local contents $2
    :local existing [/file/find where name=$fileName]
    :if ([:len $existing] = 0) do={
        /file/add name=$fileName contents=$contents
    } else={
        /file/set $existing contents=$contents
    }
}
:local recordHistory do={
    :local event $1
    :local candidate $2
    :local detail $3
    :local previous ""
    :do { :set previous [/file/get [find where name=$historyFile] contents] } on-error={}
    # Keep the journal bounded on router storage. It contains only public image
    # identity and lifecycle outcomes, never credentials or application data.
    :if ([:len $previous] > 12000) do={ :set previous "" }
    :local historyEntry ([/system/clock/get date] . " " . [/system/clock/get time] . " event=" . $event . " image=" . $candidate . " detail=" . $detail)
    :if ([:len $previous] > 0) do={ :set historyEntry ($previous . "\n" . $historyEntry) }
    $writeState $historyFile $historyEntry
}
:local stateLine do={
    :local contents $1
    :local key $2
    :local start [:find $contents $key]
    :if ($start = nil) do={ :return "" }
    :set start ($start + [:len $key])
    :local ending [:find $contents "\n" $start]
    :if ($ending = nil) do={ :return [:pick $contents $start [:len $contents]] }
    :return [:pick $contents $start $ending]
}
:local recordFailure do={
    :local candidate $1
    :local previous ""
    :do { :set previous [/file/get [find where name=$failureFile] contents] } on-error={}
    :local count 1
    :if (($stateLine $previous "failed-image=") = $candidate) do={
        :local priorCount [$stateLine $previous "failure-count="]
        :if ([:typeof [:tonum $priorCount]] = "num") do={ :set count ([:tonum $priorCount] + 1) }
    }
    :local failureState ("failed-image=" . $candidate . "\nfailure-count=" . $count . "\nfailed-at=" . [/system/clock/get date] . " " . [/system/clock/get time])
    $writeState $failureFile $failureState
    $recordHistory "failed" $candidate ("attempt=" . $count)
}

# A dashboard can terminate TLS at a separate router-local proxy. In that
# design, the controller must probe the isolated VETH address directly. HTTPS
# remains accepted for installations that expose a certificate-validated
# readiness endpoint. Plain HTTP is intentionally restricted to a literal
# RFC1918 IPv4 address, port 8080, and the exact /readyz path. It cannot use
# DNS, loopback, link-local, multicast, public ranges, a query, or a fragment.
:local readinessTransport do={
    :local endpoint $1
    :if (([:len $endpoint] > 8) && ([:pick $endpoint 0 8] = "https://")) do={
        :return "https"
    }
    :if (([:len $endpoint] <= 7) || ([:pick $endpoint 0 7] != "http://")) do={
        :error "readiness URL must use HTTPS or private router-local HTTP"
    }
    :local requiredSuffix ":8080/readyz"
    :local suffixStart [:find $endpoint $requiredSuffix]
    :if (($suffixStart = nil) || (($suffixStart + [:len $requiredSuffix]) != [:len $endpoint])) do={
        :error "private HTTP readiness URL must use port 8080 and exact /readyz path"
    }
    :local host [:pick $endpoint 7 $suffixStart]
    :local privatePrefix false
    :foreach prefix in={"10.";"192.168.";"172.16.";"172.17.";"172.18.";"172.19.";"172.20.";"172.21.";"172.22.";"172.23.";"172.24.";"172.25.";"172.26.";"172.27.";"172.28.";"172.29.";"172.30.";"172.31."} do={
        :if ([:pick $host 0 [:len $prefix]] = $prefix) do={ :set privatePrefix true }
    }
    :if (!$privatePrefix) do={
        :error "plain HTTP readiness must use a private RFC1918 IPv4 address"
    }
    :local parsedIp ""
    :do { :set parsedIp [:toip $host] } on-error={ :error "private HTTP readiness host is malformed" }
    :if (([:typeof $parsedIp] != "ip") || ([:tostr $parsedIp] != $host)) do={
        :error "private HTTP readiness host is malformed"
    }
    :return "http"
}
:local fetchReady do={
    :local endpoint $1
    :local transport $2
    :local expectedCommit $3
    :local result
    :local fetchFailed false
    :local fetchAttributes
    :local fetchErrorCode
    :onerror fetchError,fetchAttributes in={
        :if ($transport = "https") do={
            :set result [/tool/fetch url=$endpoint mode=https check-certificate=yes output=user as-value]
        } else={
            :set result [/tool/fetch url=$endpoint mode=http output=user as-value]
        }
    } do={
        :set fetchFailed true
        :set fetchErrorCode ($fetchAttributes->"code")
    }
    :if ($fetchFailed) do={
        :if ($fetchErrorCode != nil) do={ :return ("http-error-" . $fetchErrorCode) }
        :return "fetch-error"
    }
    :if (($result->"status") != "finished") do={ :return "fetch-incomplete" }
    :if (($result->"code") != 200) do={ :return ("http-status-" . ($result->"code")) }
    :local body ($result->"data")
    :if ([:typeof $body] != "str") do={ :return "empty-response" }
    :if ([:find $body "\"status\":\"ready\""] = nil) do={ :return "not-ready" }
    :local expectedRevision ("\"revision\":\"" . $expectedCommit . "\"")
    :if ([:find $body $expectedRevision] = nil) do={ :return "revision-mismatch" }
    :return "ready"
}

# RouterOS job state is authoritative for overlap detection. The legacy global
# is retained only as a diagnostic flag: it may remain true after an interrupted
# run and must never prevent a later run from recovering. The known-good image
# is also written to router-local storage for operator review; that file contains
# no credentials or application data.
:global vpnGuiImmutableUpdateLock
:local activeUpdaterRuns [/system script job print count-only as-value where script=[:jobname]]
:if ($activeUpdaterRuns > 1) do={
    :log warning "vpn-gui immutable updater: another run is active; skipping"
    :error "vpn-gui immutable updater lock held"
}
:set vpnGuiImmutableUpdateLock true

:do {
    :if (($maintenanceStartHour < 0) || ($maintenanceStartHour > 23) || ($maintenanceEndHour < 0) || ($maintenanceEndHour > 23)) do={
        :error "maintenance window hours must be between 0 and 23"
    }
    :if ($maintenanceWindowEnabled) do={
        :local currentHour [:tonum [:pick [/system/clock/get time] 0 2]]
        :local inWindow false
        :if ($maintenanceStartHour = $maintenanceEndHour) do={ :set inWindow true }
        :if ($maintenanceStartHour < $maintenanceEndHour) do={
            :if (($currentHour >= $maintenanceStartHour) && ($currentHour < $maintenanceEndHour)) do={ :set inWindow true }
        } else={
            :if (($currentHour >= $maintenanceStartHour) || ($currentHour < $maintenanceEndHour)) do={ :set inWindow true }
        }
        :if (!$inWindow) do={
            :log info ("vpn-gui immutable updater: outside maintenance window; next run will retry")
            :error "outside maintenance window"
        }
    }
    # Fetch JSON only over certificate-validated HTTPS.  This value is data,
    # never passed to :parse, :execute, or :import.
    # GitHub release assets redirect once to a signed asset host.  Keep that
    # transport behaviour explicit and bounded; do not follow arbitrary chains.
    # GitHub's release-asset endpoint may be served by an intermediary cache
    # after an asset is replaced in place.  Make each read URL distinct without
    # making the release data executable: the response is still JSON-only,
    # HTTPS-only, certificate-validated, and redirect-bounded below. Keep the
    # query short and numeric: this form was verified with RouterOS fetch.
    :local manifestRequestUrl ($manifestUrl . "?cb=" . [:rndnum from=100000 to=999999])
    :local fetched [/tool/fetch url=$manifestRequestUrl mode=https check-certificate=yes http-max-redirect-count=2 output=user as-value]
    :if (($fetched->"status") != "finished") do={
        :error "release manifest fetch did not finish"
    }
    :local manifest [:deserialize from=json value=($fetched->"data")]
    :local schema ($manifest->"schema")
    :local images ($manifest->"images")
    :local image ($images->"arm64")
    :local commit ($manifest->"commit")

    # Fail closed unless the manifest names this format exactly:
    # ghcr.io/<configured public owner>/mikrotik-openvpn-gui:sha-<40 lowercase hex>-arm64
    :if ($schema != 1) do={
        :error "manifest schema is not accepted"
    }
    :if (([:typeof $image] != "str") || ([:typeof $commit] != "str")) do={
        :error "manifest image or commit is not a string"
    }
    :local prefixLength [:len $imagePrefix]
    :local expectedLength ($prefixLength + 46)
    :if (([:len $image] != $expectedLength) || ([:pick $image 0 $prefixLength] != $imagePrefix) || ([:pick $image ($prefixLength + 40) $expectedLength] != "-arm64")) do={
        :error "manifest image is not an allowed immutable ARM64 image"
    }
    :local imageCommit [:pick $image $prefixLength ($prefixLength + 40)]
    :if (([:len $commit] != 40) || ($commit != $imageCommit)) do={
        :error "manifest commit does not match the immutable image tag"
    }
    :local hex "0123456789abcdef"
    :for index from=0 to=39 do={
        :local character [:pick $commit $index ($index + 1)]
        :if ([:find $hex $character] = nil) do={
            :error "manifest commit contains a non-lowercase-hex character"
        }
    }
    :local canaryReadyTransport [$readinessTransport $canaryReadyUrl]

    # Do not repeatedly disrupt a canary for the same previously rejected
    # immutable candidate. A new SHA begins with a fresh failure count.
    :local previousFailure ""
    :do { :set previousFailure [/file/get [find where name=$failureFile] contents] } on-error={}
    :local failedImage [$stateLine $previousFailure "failed-image="]
    :local failedCountText [$stateLine $previousFailure "failure-count="]
    :local failedCount 0
    :local skipUpdate false
    :do { :set failedCount [:tonum $failedCountText] } on-error={}
    :if (($failedImage = $image) && ($failedCount >= $failureRetryLimit)) do={
        :log error ("vpn-gui immutable updater: candidate is locally quarantined after failures: " . $image)
        :set skipUpdate true
    }

    :local canaryId [/container/find where name=$canaryContainer]
    :local productionId [/container/find where name=$productionContainer]
    :if ([:len $canaryId] != 1) do={ :error "exactly one named canary container is required" }
    :if ([:len $productionId] != 1) do={ :error "exactly one named production container is required" }

    # No-op if production already runs this exact immutable release.
    :local productionCurrent [/container/get $productionId remote-image]
    :if (([:len $productionCurrent] != $expectedLength) || ([:pick $productionCurrent 0 $prefixLength] != $imagePrefix) || ([:pick $productionCurrent ($prefixLength + 40) $expectedLength] != "-arm64")) do={
        :error "production must already use an allowed immutable ARM64 image before automatic updates are enabled"
    }
    :if ($productionCurrent = $image) do={
        :log info ("vpn-gui immutable updater: production already uses " . $image)
        :set skipUpdate true
    }
    :local canaryCurrent [/container/get $canaryId remote-image]
    :local pendingState ""
    :do { :set pendingState [/file/get [find where name=$pendingFile] contents] } on-error={}
    :local pendingImage [$stateLine $pendingState "candidate-image="]
    :local pendingProduction [$stateLine $pendingState "prior-production-image="]
    :if (($canaryCurrent = $image) && ($pendingImage = $image) && ($pendingProduction = $productionCurrent)) do={
        :log info ("vpn-gui immutable updater: candidate already staged; production unchanged " . $image)
        :set skipUpdate true
    }
    :if ($dryRun) do={
        :log warning ("vpn-gui immutable updater: dry-run accepted candidate " . $image . "; no container changed")
        :set skipUpdate true
    }
    :if (!$skipUpdate) do={
        # Validate policy before even changing the isolated canary.
        :if ($canaryValidationSamples < 30) do={ :error "canary requires at least 30 readiness samples" }
        :if ($canaryValidationInterval < 1m) do={ :error "canary readiness samples must be at least one minute apart" }
    }

    # The script only changes the isolated canary image/lifecycle and local
    # release metadata. It never changes production. It never
    # writes mountlists, envlists, root-dir, interface, router configuration,
    # SQLite data, certificates, users, firewall, or proxy settings.
    :if (!$skipUpdate) do={
        :log info ("vpn-gui immutable updater: testing canary " . $image)
        :local canaryRestoreImage $canaryCurrent
        :if ($canaryCurrent = $image) do={ :set canaryRestoreImage $productionCurrent }
        :do {
        /container/stop $canaryId
        /container/set $canaryId remote-image=$image
        /container/update $canaryId
        /container/start $canaryId
    } on-error={
        :log error ("vpn-gui immutable updater: canary extraction/start failed; restoring " . $canaryRestoreImage)
        $recordFailure $image
        :do {
            /container/stop $canaryId
            /container/set $canaryId remote-image=$canaryRestoreImage
            /container/update $canaryId
            /container/start $canaryId
        } on-error={ :log error "vpn-gui immutable updater: canary rollback also failed; operator action required" }
        :error "canary lifecycle gate failed"
    }

    :local canaryHealthy false
    :for attempt from=1 to=$pollAttempts do={
        :delay $pollDelay
        :local readinessResult "check-error"
        :do {
            :set readinessResult [$fetchReady $canaryReadyUrl $canaryReadyTransport $commit]
            :if ($readinessResult = "ready") do={
                :set canaryHealthy true
            }
        } on-error={ :set readinessResult "check-error" }
        :if (!$canaryHealthy) do={
            :log warning ("vpn-gui immutable updater: canary readiness attempt " . $attempt . " result=" . $readinessResult)
        }
        :if ($canaryHealthy) do={ :break }
    }
    :if (!$canaryHealthy) do={
        :log error ("vpn-gui immutable updater: canary rejected " . $image . "; restoring " . $canaryRestoreImage . "; production unchanged")
        $recordFailure $image
        :do {
            /container/stop $canaryId
            /container/set $canaryId remote-image=$canaryRestoreImage
            /container/update $canaryId
            /container/start $canaryId
        } on-error={ :log error "vpn-gui immutable updater: canary rollback also failed; operator action required" }
        :error "canary readiness gate failed"
    }

    # Do not stage based on a single delayed probe. Require at least 30
    # successful readiness samples spaced at least 60 seconds apart; any
    # failed, incomplete, or mismatched-revision response rejects and rolls back
    # the candidate while production remains untouched.
    :local canaryStable true
    :for sample from=1 to=$canaryValidationSamples do={
        :delay $canaryValidationInterval
        :local canarySampleResult "check-error"
        :do {
            :set canarySampleResult [$fetchReady $canaryReadyUrl $canaryReadyTransport $commit]
        } on-error={ :set canarySampleResult "check-error" }
        :if ($canarySampleResult != "ready") do={
            :set canaryStable false
            :log error ("vpn-gui immutable updater: canary sample " . $sample . "/" . $canaryValidationSamples . " result=" . $canarySampleResult)
            :break
        }
        :log info ("vpn-gui immutable updater: canary readiness sample " . $sample . "/" . $canaryValidationSamples . " passed revision=" . $commit)
    }
    :if (!$canaryStable) do={
        :log error ("vpn-gui immutable updater: canary readiness soak failed; restoring " . $canaryRestoreImage . "; production unchanged")
        $recordFailure $image
        :do {
            /container/stop $canaryId
            /container/set $canaryId remote-image=$canaryRestoreImage
            /container/update $canaryId
            /container/start $canaryId
        } on-error={ :log error "vpn-gui immutable updater: canary rollback also failed; operator action required" }
        :error "canary readiness soak failed"
    }
    :log info ("vpn-gui immutable updater: canary readiness soak passed samples=" . $canaryValidationSamples)

    :local pending ("candidate-image=" . $image . "\nprior-production-image=" . $productionCurrent . "\ncommit=" . $commit . "\nstaged-at=" . [/system/clock/get date] . " " . [/system/clock/get time])
    $writeState $pendingFile $pending
    $recordHistory "canary-staged" $image "readiness-soak-passed; production-unchanged"
    :log info ("vpn-gui immutable updater: canary staged; full acceptance and explicit promotion controller required; production unchanged " . $image)
    }
} on-error={ :log error "vpn-gui immutable updater: update failed; see preceding log entry" }
:set vpnGuiImmutableUpdateLock false

# Example watchdog scheduler. Import only after replacing CHANGE-ME values
# above, then test by running the script manually. Five minutes gives fast
# detection while the immutable SHA, single-run lock, canary gate, readiness
# checks, rollback, and three-failure quarantine prevent unsafe promotion.
# A quarantined candidate is skipped until the operator reviews it and removes
# the local .failed state file. The script itself remains local on the router.
# /system/scheduler/add name="vpn-gui-immutable-update" interval=5m start-time=startup on-event="/system/script/run vpn-gui-immutable-update" policy=read,write,policy,test,password,sensitive
