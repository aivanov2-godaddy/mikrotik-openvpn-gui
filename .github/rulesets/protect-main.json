{
  "name": "Protect main",
  "target": "branch",
  "source_type": "Repository",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": [
        "refs/heads/main"
      ],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "pull_request",
      "parameters": {
        "allowed_merge_methods": [
          "squash"
        ],
        "dismiss_stale_reviews_on_push": false,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_approving_review_count": 0,
        "required_review_thread_resolution": false
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          {
            "context": "Pre-commit hooks"
          },
          {
            "context": "Secret patterns"
          },
          {
            "context": "Dependency vulnerability audit"
          },
          {
            "context": "Python 3.13 tests"
          },
          {
            "context": "Python 3.14 tests"
          },
          {
            "context": "Redis outbox recovery integration"
          },
          {
            "context": "Socket.IO same-origin security contract"
          },
          {
            "context": "Rendered browser and accessibility regression"
          },
          {
            "context": "ARM64 image build"
          }
        ],
        "strict_required_status_checks_policy": true
      }
    }
  ],
  "bypass_actors": []
}
